---
import Base from '../layouts/Base.astro';
import data from '../data/store.json';

// Dark launch: this page is not linked from the nav or the sitemap, and Base marks pages
// without a `path` as noindex, so search engines leave it alone until the store is ready.
const { products, personalization, shipping } = data;

const sellable = (product) => product.status === 'available' && product.stripeProductId;
const liveCount = products.filter(sellable).length;

// Only what can actually be bought is handed to the browser; the server re-prices it all anyway.
const catalogue = products.filter(sellable).map((product) => ({
  id: product.id,
  title: product.title,
  format: product.format,
  price: Number(product.price),
  shipped: product.shipped,
  personalizable: product.personalizable,
}));

const statusLabel = { 'out-of-stock': 'Out of stock', 'coming-soon': 'Coming soon' };
---
<Base title="Store (Beta) — Jonah Kim" description="Preview of the Jonah Kim store.">
  <p class="beta-flag"><strong>Preview.</strong> This page is a work in progress and isn&rsquo;t linked from the site.{liveCount === 0
    ? ' Checkout isn’t connected yet, so nothing can be bought here.'
    : ' Checkout runs in Stripe test mode — no real card is charged.'}</p>

  <h1 class="page-title">Store</h1>
  <p class="contact-intro">Signed CDs and sheet music, direct from Jonah. Prices include US shipping.</p>

  <div class="store-grid">
    {products.map((product) => (
      <div class={`product${product.status === 'available' ? '' : ' product-unavailable'}`}>
        <div class="product-media">
          {product.image
            ? <img src={product.image} alt={`${product.title} cover`} loading="lazy" width="1000" height="1000">
            : <div class="product-placeholder" aria-hidden="true"><span>{product.format}</span></div>}
        </div>
        <div class="product-body">
          <p class="product-format">{product.format}</p>
          <h2>{product.title}</h2>
          <p class="product-price"><span class="price-now">${product.price}</span></p>
          {product.description && <p class="product-description">{product.description}</p>}
          <div class="product-actions">
            {sellable(product)
              ? <button type="button" class="btn solid" data-add={product.id}>Add to Basket</button>
              : <span class="product-status">{statusLabel[product.status] ?? 'Not yet available'}</span>}
            {product.listen && <a class="text-link" href={product.listen} target="_blank" rel="noopener">Listen online</a>}
          </div>
        </div>
      </div>
    ))}
  </div>

  <section class="basket" id="basket" aria-labelledby="basket-title" hidden>
    <h2 class="section-title" id="basket-title">Your basket</h2>
    <ul class="basket-items" id="basket-items"></ul>

    <div class="basket-destination" id="basket-destination" hidden>
      <span class="basket-destination-label">Deliver to</span>
      <label><input type="radio" name="destination" value="us" checked> United States &mdash; shipping included</label>
      <label><input type="radio" name="destination" value="international"> Outside the US &mdash; adds ${shipping.international.price}</label>
    </div>

    <div class="basket-foot">
      <p class="basket-total">Total <span id="basket-total">$0.00</span></p>
      <p class="basket-note" id="basket-note"></p>
      <button type="button" class="btn solid" id="basket-checkout">Checkout</button>
      <p class="form-status" id="basket-error" role="status" aria-live="polite" hidden></p>
    </div>
  </section>

  <div class="notice store-note">
    <p><strong>Still to do</strong></p>
    <ul>
      <li>Run <code>scripts/stripe-seed.mjs</code> with Jonah&rsquo;s test key to create the Stripe products.</li>
      <li>Create the $0 US and ${shipping.international.price} international shipping rates in Stripe and paste their IDs into <code>src/data/store.json</code>.</li>
      <li>Add <code>STRIPE_SECRET_KEY</code> to the Vercel project.</li>
      <li>Cover art for Trinity, the sheet music, and Bach IV&ndash;VI.</li>
      <li>Apparel once it is restocked; individual song PDFs once the titles are known.</li>
    </ul>
  </div>

  <script slot="end" is:inline define:vars={{ catalogue, personalization, intlPrice: Number(shipping.international.price) }}>
    // Basket lives in this browser only; the server re-prices everything from the catalogue at checkout.
    (function () {
      var KEY = 'jonah-basket-v2';
      var items = {};
      var basket = document.getElementById('basket');
      var list = document.getElementById('basket-items');
      var totalEl = document.getElementById('basket-total');
      var noteEl = document.getElementById('basket-note');
      var errorEl = document.getElementById('basket-error');
      var checkout = document.getElementById('basket-checkout');
      var destinationBox = document.getElementById('basket-destination');
      var byId = {};
      catalogue.forEach(function (product) { byId[product.id] = product; });

      try { items = JSON.parse(localStorage.getItem(KEY)) || {}; } catch (e) { items = {}; }
      Object.keys(items).forEach(function (id) { if (!byId[id]) delete items[id]; });

      function save() {
        try { localStorage.setItem(KEY, JSON.stringify(items)); } catch (e) { /* private browsing */ }
      }
      function money(value) { return '$' + value.toFixed(2); }
      function destination() {
        var picked = document.querySelector('input[name="destination"]:checked');
        return picked ? picked.value : 'us';
      }

      function render() {
        var ids = Object.keys(items);
        basket.hidden = ids.length === 0;
        list.textContent = '';
        var total = 0;
        var anyShipped = false;
        var signedCount = 0;

        ids.forEach(function (id) {
          var product = byId[id];
          var entry = items[id];
          total += product.price * entry.quantity;
          if (product.shipped) anyShipped = true;
          if (entry.personalize) signedCount += entry.quantity;

          var row = document.createElement('li');
          row.className = 'basket-item';

          var name = document.createElement('div');
          name.className = 'basket-item-name';
          name.textContent = product.title;
          var format = document.createElement('span');
          format.textContent = product.format;
          name.appendChild(format);

          if (product.personalizable) {
            var personalizeLabel = document.createElement('label');
            personalizeLabel.className = 'basket-personalize';
            var box = document.createElement('input');
            box.type = 'checkbox';
            box.checked = Boolean(entry.personalize);
            box.addEventListener('change', function () {
              items[id].personalize = box.checked;
              save();
              render();
            });
            personalizeLabel.appendChild(box);
            personalizeLabel.append(' ' + personalization.label + ' ' + personalization.price_label);
            name.appendChild(personalizeLabel);
          }

          var controls = document.createElement('div');
          controls.className = 'basket-qty';
          [['−', -1, 'Remove one ' + product.title], ['+', 1, 'Add one ' + product.title]].forEach(function (spec, index) {
            var button = document.createElement('button');
            button.type = 'button';
            button.textContent = spec[0];
            button.setAttribute('aria-label', spec[2]);
            button.addEventListener('click', function () { change(id, spec[1]); });
            if (index === 1) {
              var count = document.createElement('span');
              count.className = 'basket-count';
              count.textContent = String(entry.quantity);
              controls.appendChild(count);
            }
            controls.appendChild(button);
          });

          var lineTotal = document.createElement('div');
          lineTotal.className = 'basket-line-total';
          lineTotal.textContent = money(product.price * entry.quantity);

          var remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'basket-remove';
          remove.textContent = 'Remove';
          remove.setAttribute('aria-label', 'Remove ' + product.title + ' from the basket');
          remove.addEventListener('click', function () { delete items[id]; save(); render(); });

          row.appendChild(name);
          row.appendChild(controls);
          row.appendChild(lineTotal);
          row.appendChild(remove);
          list.appendChild(row);
        });

        if (signedCount > 0) total += Number(personalization.price) * signedCount;
        destinationBox.hidden = !anyShipped;
        var intl = anyShipped && destination() === 'international';
        if (intl) total += intlPrice;

        totalEl.textContent = money(total);

        var notes = [];
        if (signedCount > 0) notes.push(signedCount + ' signed ' + (signedCount === 1 ? 'copy' : 'copies') + ' · ' + personalization.cdNote);
        if (anyShipped) notes.push(intl ? 'International shipping added.' : 'US shipping is included in the price.');
        else notes.push('Downloads are emailed after your order — no address needed.');
        notes.push('Tax, if any, is calculated at checkout.');
        noteEl.textContent = notes.join(' ');
      }

      function change(id, delta) {
        var entry = items[id] || { quantity: 0, personalize: false };
        var next = entry.quantity + delta;
        if (next < 1) delete items[id];
        else if (next <= 10) items[id] = { quantity: next, personalize: entry.personalize };
        save();
        render();
      }

      document.querySelectorAll('[data-add]').forEach(function (button) {
        button.addEventListener('click', function () {
          change(button.dataset.add, 1);
          basket.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
      });

      destinationBox.addEventListener('change', render);

      checkout.addEventListener('click', function () {
        var payload = Object.keys(items).map(function (id) {
          return { id: id, quantity: items[id].quantity, personalize: Boolean(items[id].personalize) };
        });
        if (payload.length === 0) return;
        checkout.disabled = true;
        checkout.textContent = 'Starting checkout…';
        errorEl.hidden = true;

        fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: payload, destination: destination() }),
        })
          .then(function (response) {
            return response.json().catch(function () { return {}; }).then(function (data) {
              if (!response.ok || !data.url) throw new Error(data.error || 'Checkout could not be started.');
              window.location.href = data.url;
            });
          })
          .catch(function (err) {
            errorEl.textContent = err.message + ' Please try again, or email Jonah if it keeps happening.';
            errorEl.hidden = false;
            checkout.disabled = false;
            checkout.textContent = 'Checkout';
          });
      });

      render();
    })();
  </script>
</Base>
